{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobble Launcher",
  "mainBinaryName": "Cobble Launcher",
  "version": "0.2.2",
  "identifier": "dev.mclauncher.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cobble Launcher",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https://cdn.modrinth.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'none'; object-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "loxord241",
    "copyright": "Copyright © 2026 loxord241",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "Ukrainian"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENzFBN0JEODdBOEYxRDYKUldUVzhhaUh2YWR4L1VZUjRZa0d2V2ZWZ0t6TGxvYnphWndPQmYyMFRZWVFZeUV2S3d0TkMyV04K",
      "endpoints": [
        "https://github.com/loxord241/Cobble-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
